// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         String
  createdAt    DateTime @default(now()) @map("created_at")

  stores Store[]

  @@map("users")
}

model Store {
  id             Int      @id @default(autoincrement())
  ownerUserId    Int      @map("owner_user_id")
  name           String
  slug           String
  plan           String
  allowsDelivery Boolean  @default(false) @map("allows_delivery")
  allowsPickup   Boolean  @default(false) @map("allows_pickup")
  createdAt      DateTime @default(now()) @map("created_at")

  owner        User?         @relation(fields: [ownerUserId], references: [id])
  customers    Customer[]
  products     Product[]
  categories   Category[]
  inventories  Inventory[]
  carts        Cart[]
  orders       Order[]
  flashSales   FlashSale[]
  domains      Domain[]
  storeConfigs StoreConfig[]

  @@map("stores")
}

model StoreConfig {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  version       Int
  schemaVersion String   @map("schema_version")
  contentJson   Json     @map("content_json")
  status        String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_configs")
}

enum StoreConfigStatus {
  ACTIVE
  BACKUP
}

model Domain {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  hostname  String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id])

  @@map("domains")
}

model Customer {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  name         String
  phone        String
  email        String
  passwordHash String?  @map("password_hash")
  address      String
  createdAt    DateTime @default(now()) @map("created_at")

  store        Store         @relation(fields: [storeId], references: [id])
  carts        Cart[]
  orders       Order[]
  reservations Reservation[]

  @@unique([storeId, email])
  @@map("customers")
}

model Product {
  id                Int               @id @default(autoincrement())
  storeId           Int               @map("store_id")
  name              String
  slug              String
  description       String
  price             Decimal
  currency          String
  imageUrl          String?           @map("image_url")
  status            ProductStatus     @default(ACTIVE)
  store             Store             @relation(fields: [storeId], references: [id])
  inventories       Inventory?
  productCategories ProductCategory[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  flashSales        FlashSale[]

  @@unique([storeId, slug])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")

  store             Store             @relation(fields: [storeId], references: [id])
  productCategories ProductCategory[]

  @@unique([storeId, slug])
  @@map("categories")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  productId     Int      @unique @map("product_id")
  stockCount    Int      @default(0) @map("stock_count")
  reservedCount Int      @default(0) @map("reserved_count")
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@map("inventories")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model Cart {
  id         Int        @id @default(autoincrement())
  storeId    Int        @map("store_id")
  customerId Int        @map("customer_id")
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  store     Store      @relation(fields: [storeId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
  cartItems CartItem[]

  @@unique([storeId, customerId])
  @@map("carts")
}

enum CartStatus {
  ACTIVE
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price")
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

//next now order. and order item and payment next 
model Order {
  id                      Int              @id @default(autoincrement())
  storeId                 Int              @map("store_id")
  customerId              Int              @map("customer_id")
  status                  OrderStatus      @default(PENDING)
  fulfillmentType         FullfillmentType @map("fullfillment_type")
  totalAmount             Decimal          @map("total_amount")
  currency                String           @default("INR")
  deliveryAddressSnapshot String?          @map("delivery_address_snapshot")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  orderItems   OrderItem[]
  payments     Payment[]
  reservations Reservation[]

  @@map("orders")
}

enum FullfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  productId       Int      @map("product_id")
  quantity        Int
  priceAtPurchase Decimal  @map("price_at_purchase")
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id      Int @id @default(autoincrement())
  orderId Int @map("order_id")

  order             Order         @relation(fields: [orderId], references: [id])
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  amount            Decimal
  currency          String        @default("INR")
  method            String
  status            PaymentStatus @default(PROCESSING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model FlashSale {
  id                  Int      @id @default(autoincrement())
  storeId             Int      @map("store_id")
  productId           Int      @map("product_id")
  startsAt            DateTime @map("starts_at")
  endsAt              DateTime @map("ends_at")
  salePrice           Decimal  @map("sale_price")
  stockLimit          Int      @map("stock_limit")
  reservationQuantity Int      @map("reservation_quantity")
  soldQuantity        Int      @map("sold_quantity")
  createdAt           DateTime @default(now()) @map("created_at")

  store        Store         @relation(fields: [storeId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  reservations Reservation[]

  @@map("flash_sales")
}

model Reservation {
  id          Int               @id @default(autoincrement())
  flashSaleId Int               @map("flash_sale_id")
  customerId  Int               @map("customer_id")
  order_id    Int               @map("order_id")
  quantity    Int
  status      ReservationStatus @default(RESERVED)
  expiresAt   DateTime          @map("expires_at")
  createdAt   DateTime          @map("created_at")

  order     Order      @relation(fields: [order_id], references: [id])
  flashSale FlashSale? @relation(fields: [flashSaleId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
}

enum ReservationStatus {
  RESERVED
  PURCHASED
  EXPIRED
  CANCELLED
}
