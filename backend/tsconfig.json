{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2022",

        "rootDir": ".",
        "outDir": "./dist",

        "strict": true,
        "sourceMap": true,

        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,

        "types": ["node", "vitest/globals"]
    },
    "include": ["src/**/*.ts", "prisma/**/*.ts"]
}
